# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: AI provider (Phase 2 coach / narratives)
OPENAI_API_KEY=

# Basiq Open Banking (server-only — never expose to client)
# Create a key at https://dashboard.basiq.io
# Set redirect URL to http://localhost:3000/banks/callback
BASIQ_API_KEY=
# BASIQ_API_URL=https://au-api.basiq.io
# BASIQ_API_VERSION=3.0

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
